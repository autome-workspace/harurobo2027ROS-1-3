Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Enabled: true
  Global Options:
    Fixed Frame: amt102_view
    Frame Rate: 30
    Background Color: 18; 26; 38
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Display grid
    Cell Size: 0.25
    Plane Cell Count: 20
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: AMT102 CH1 CH2
    Namespaces: {}
    Topic:
      Value: /encoders/markers
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
    Value: true
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Pitch: 1.2
      Yaw: 1.57
      Focal Point: {X: 0.0, Y: -0.15, Z: 0.0}
Window Geometry:
  Width: 1100
  Height: 750
