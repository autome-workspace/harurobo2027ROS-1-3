<?xml version="1.0"?>
<sdf version="1.9">
  <world name="training">
    <physics name="default" type="dart">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <direction>-0.4 0.2 -1</direction>
    </light>
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>10 10 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 10 0.1</size></box></geometry>
          <material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.40 0.42 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="north_wall">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>8 0.15 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 1</size></box></geometry>
          <material><ambient>0.70 0.72 0.76 1</ambient><diffuse>0.70 0.72 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>8 0.15 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 1</size></box></geometry>
          <material><ambient>0.70 0.72 0.76 1</ambient><diffuse>0.70 0.72 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>4 0 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.15 8 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 8 1</size></box></geometry>
          <material><ambient>0.70 0.72 0.76 1</ambient><diffuse>0.70 0.72 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-4 0 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.15 8 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 8 1</size></box></geometry>
          <material><ambient>0.70 0.72 0.76 1</ambient><diffuse>0.70 0.72 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle">
      <static>true</static>
      <pose>2 1.6 0.4 0 0 0.35</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.9 0.7 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.7 0.8</size></box></geometry>
          <material><ambient>0.75 0.35 0.12 1</ambient><diffuse>0.75 0.35 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>-2.4 -1.2 0.45 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.55 0.55 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.55 0.55 0.9</size></box></geometry>
          <material><ambient>0.25 0.38 0.6 1</ambient><diffuse>0.25 0.38 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://harurobo</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
